# ----------------------------------------------------------------------------
# Tinewe Backend Configuration (.env)
# ----------------------------------------------------------------------------

# 1. Supabase Database & Storage Configuration
# Get these values from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=

# 2. Telephony & Real Emergency Alert Services (Twilio / E.164 Cellular Dispatch)
# Required for sending real SMS text alerts to ICE numbers and making live emergency voice calls
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 3. Emergency Dispatch Phone Number
# Destination E.164 phone number for automated voice emergency dispatch (Default: SAPS Control +27114868000 / ER24 +2784124)
EMERGENCY_DISPATCH_PHONE=+27114868000
